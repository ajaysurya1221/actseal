{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actseal:schema:selection:1",
  "title": "Actseal calibration selection result (schema 1)",
  "description": "Every prespecified grid point and its descriptive calibration counts. The Python reader checks exact counts and selected threshold; predicted probabilities use absolute tolerance 1e-10 and relative tolerance 1e-9.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "threshold",
    "reason",
    "points"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "threshold": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "enum": [
        "selected",
        "calibration.no_threshold"
      ]
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "threshold",
          "accepted",
          "errors",
          "predicted_pass_probability"
        ],
        "properties": {
          "threshold": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "accepted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "errors": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "predicted_pass_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "selected"
          }
        }
      },
      "then": {
        "properties": {
          "threshold": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      },
      "else": {
        "properties": {
          "threshold": {
            "type": "null"
          }
        }
      }
    }
  ]
}
