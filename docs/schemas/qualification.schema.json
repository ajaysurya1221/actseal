{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actseal:schema:qualification:1",
  "title": "Actseal qualification receipt (schema 1)",
  "description": "Links the exact calibration manifest bytes, the ordinary verification lock's self-seal, and its unchanged verification verdict. No response authentication or proof of execution chronology is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_manifest_sha256",
    "lock_sha256",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "calibration_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "$defs": {
    "Interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "Verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons",
        "total",
        "accepted",
        "errors",
        "risk",
        "coverage",
        "evidence_scope",
        "lock_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "BLOCK",
            "INCONCLUSIVE",
            "ERROR"
          ]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "risk": {
          "$ref": "#/$defs/Interval"
        },
        "coverage": {
          "$ref": "#/$defs/Interval"
        },
        "evidence_scope": {
          "enum": [
            "demo",
            "iid"
          ]
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
